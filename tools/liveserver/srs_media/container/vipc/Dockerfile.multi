FROM golang:1.20 as builder
ENV GOPROXY https://goproxy.cn
ENV GO111MODULE on
COPY . /
WORKDIR /rtsp-simple-server
RUN go mod download & go build -o rtsp-simple-server .

FROM golang:1.20
COPY --from=builder /rtsp-simple-server/rtsp-simple-server /rtsp-simple-server/rtsp-simple-server
#COPY --from=builder /rtsp-simple-server/rtsp-simple-server.yml /rtsp-simple-server/rtsp-simple-server.yml
WORKDIR /rtsp-simple-server
ENTRYPOINT ./rtsp-simple-server
